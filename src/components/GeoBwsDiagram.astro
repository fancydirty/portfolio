---
// Geo BWS Content Pipeline Workflow Diagram for WorkDossier section
// Inline SVG - no external dependencies
---

<svg
  viewBox="0 0 800 520"
  width="100%"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-labelledby="geo-title geo-desc"
  xmlns="http://www.w3.org/2000/svg"
  style="display: block; max-width: 100%;"
>
  <title id="geo-title">private content pipeline</title>
  <desc id="geo-desc">Flowchart showing content inventory, direction selection, writing, QA, distribution, hero generation, verification, and publishing.</desc>

  <defs>
    <filter id="geo-shadow" x="-2%" y="-2%" width="104%" height="104%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#34302c" flood-opacity="0.08"/>
    </filter>
  </defs>

  <rect x="0" y="0" width="800" height="520" fill="#faf7f1" rx="4"/>

  <text
    x="400"
    y="28"
    text-anchor="middle"
    style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; fill: #9f4b16; letter-spacing: 0.05em;"
  >
    private content pipeline
  </text>

  <!-- Nodes -->

  <!-- Inventory Scan -->
  <rect x="60" y="55" width="120" height="40" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="120" y="80" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Inventory Scan</text>

  <!-- Direction Selection -->
  <rect x="220" y="55" width="130" height="40" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="285" y="80" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Direction Select</text>

  <!-- Writing Subagent -->
  <rect x="390" y="55" width="130" height="40" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="455" y="80" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Writing Subagent</text>

  <!-- Content QA -->
  <rect x="560" y="55" width="100" height="40" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="610" y="80" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Content QA</text>

  <!-- Acceptance -->
  <rect x="700" y="55" width="90" height="40" rx="20" fill="#faf7f1" stroke="#34302c" stroke-width="2" filter="url(#geo-shadow)"/>
  <text x="745" y="80" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Accept</text>

  <!-- Ledger Update -->
  <rect x="220" y="150" width="130" height="36" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="285" y="172" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Ledger Update</text>

  <!-- Distribution Subagent -->
  <rect x="390" y="150" width="150" height="36" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="465" y="172" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Distribution Subagent</text>

  <!-- Distribution QA -->
  <rect x="575" y="150" width="120" height="36" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="635" y="172" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Distribution QA</text>

  <!-- Hero Generation -->
  <rect x="60" y="240" width="130" height="36" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="125" y="262" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Hero Generation</text>

  <!-- Final Verification -->
  <rect x="240" y="240" width="130" height="36" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="305" y="262" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Final Verification</text>

  <!-- Postiz Schedule -->
  <rect x="420" y="240" width="120" height="36" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="480" y="262" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">Postiz Schedule</text>

  <!-- IndexNow Submit -->
  <rect x="580" y="240" width="120" height="36" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#geo-shadow)"/>
  <text x="640" y="262" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 500; fill: #34302c;">IndexNow Submit</text>

  <!-- Arrows -->

  <!-- Inventory -> Direction -->
  <line x1="180" y1="75" x2="220" y2="75" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="220,75 214,71 214,79" fill="#34302c"/>

  <!-- Direction -> Writing -->
  <line x1="350" y1="75" x2="390" y2="75" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="390,75 384,71 384,79" fill="#34302c"/>

  <!-- Writing -> Content QA -->
  <line x1="520" y1="75" x2="560" y2="75" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="560,75 554,71 554,79" fill="#34302c"/>

  <!-- Content QA -> Acceptance -->
  <line x1="660" y1="75" x2="700" y2="75" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="700,75 694,71 694,79" fill="#34302c"/>

  <!-- Acceptance down to middle row -->
  <polyline points="745,95 745,125 465,125 465,150" fill="none" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="465,150 461,144 469,144" fill="#34302c"/>

  <!-- Ledger Update -> Distribution -->
  <line x1="350" y1="168" x2="390" y2="168" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="390,168 384,164 384,172" fill="#34302c"/>

  <!-- Distribution -> Distribution QA -->
  <line x1="540" y1="168" x2="575" y2="168" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="575,168 569,164 569,172" fill="#34302c"/>

  <!-- Distribution QA down to bottom row -->
  <polyline points="635,186 635,215 480,215 480,240" fill="none" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="480,240 476,234 484,234" fill="#34302c"/>

  <!-- Hero Generation -> Final Verification -->
  <line x1="190" y1="258" x2="240" y2="258" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="240,258 234,254 234,262" fill="#34302c"/>

  <!-- Final Verification -> Postiz -->
  <line x1="370" y1="258" x2="420" y2="258" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="420,258 414,254 414,262" fill="#34302c"/>

  <!-- Postiz -> IndexNow -->
  <line x1="540" y1="258" x2="580" y2="258" stroke="#34302c" stroke-width="1.5"/>
  <polygon points="580,258 574,254 574,262" fill="#34302c"/>
</svg>

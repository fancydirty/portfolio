---
import type { Project } from "../data/projects";
import AdkAgentDiagram from "./AdkAgentDiagram.astro";
import WorkflowDiagram from "./WorkflowDiagram.astro";
import YTPipelineDiagram from "./YTPipelineDiagram.astro";
import GeoBwsDiagram from "./GeoBwsDiagram.astro";

type Props = {
  projects: Project[];
};

const { projects } = Astro.props;

const diagramTitleIds: Record<string, string> = {
  "adk-agent": "adk-title",
  "clawd-media-track": "workflow-title",
  "private-enterprise-workflow": "yt-title",
  "private-content-pipeline": "geo-title",
};
---

<section class="section work-section" aria-labelledby="work-heading">
  <div class="work-shell">
    <aside class="work-index" aria-labelledby="work-heading">
      <p class="eyebrow work-index-label">Index // Selected Work</p>
      <h2 id="work-heading">A small set of systems that show how I think.</h2>

      <div class="work-index-list" role="tablist" aria-label="selected work">
        {
          projects.map((project, index) => (
            <button
              class={`work-index-item ${index === 0 ? "is-active" : ""}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              data-project-tab
              data-project-id={project.id}
            >
              <span class="work-index-number">[{String(index + 1).padStart(2, "0")}]</span>
              <span class="work-index-copy">
                <strong>{project.title}</strong>
                <span>{project.summary}</span>
              </span>
            </button>
          ))
        }
      </div>
    </aside>

    <div class="dossier-stack">
      {
        projects.map((project, index) => (
          <article
            class={`dossier-panel ${index === 0 ? "is-active" : ""}`}
            data-project-panel
            data-project-id={project.id}
            hidden={index === 0 ? undefined : true}
          >
            <div class="dossier-header">
              <p class="eyebrow">Dossier</p>
              <h3>{project.title}</h3>
              <ul class="tag-list" aria-label={`${project.title} tags`}>
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>

            {project.hasDiagram && (
              <>
                <div class="workflow-diagram-wrapper" tabindex="0" role="button" aria-label="Expand diagram" data-project-id={project.id}>
                  {project.id === "adk-agent" && <AdkAgentDiagram />}
                  {project.id === "clawd-media-track" && <WorkflowDiagram />}
                  {project.id === "private-enterprise-workflow" && <YTPipelineDiagram />}
                  {project.id === "private-content-pipeline" && <GeoBwsDiagram />}
                  <span class="diagram-hint">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                  Click to expand
                </span>
                </div>
                <dialog id={`diagram-modal-${project.id}`} class="diagram-modal" aria-labelledby={diagramTitleIds[project.id]}>
                  <form method="dialog">
                    <button class="modal-close">&times; Close</button>
                  </form>
                  <div class="modal-content">
                    {project.id === "adk-agent" && <AdkAgentDiagram />}
                    {project.id === "clawd-media-track" && <WorkflowDiagram />}
                    {project.id === "private-enterprise-workflow" && <YTPipelineDiagram />}
                    {project.id === "private-content-pipeline" && <GeoBwsDiagram />}
                  </div>
                </dialog>
              </>
            )}

            <div class="dossier-grid dossier-grid-single">
              <section class="dossier-cell">
                <p class="dossier-label">What it is</p>
                <p>{project.whatItIs}</p>
              </section>

              <section class="dossier-cell">
                <p class="dossier-label">Inputs and outputs</p>
                <p>{project.inputsOutputs}</p>
              </section>

              <section class="dossier-cell">
                <p class="dossier-label">What made it hard</p>
                <p>{project.whatMadeItHard}</p>
              </section>

              <section class="dossier-cell">
                <p class="dossier-label">What I decided</p>
                <p>{project.whatIDecided}</p>
              </section>

              <section class="dossier-cell dossier-cell-wide">
                <p class="dossier-label">What changed</p>
                <p>{project.whatChanged}</p>

                {
                  project.liveLink && (
                    <p class="project-link-row">
                      <a href={project.liveLink} target="_blank" rel="noreferrer">
                        Open agent
                      </a>
                    </p>
                  )
                }

                {
                  project.link && (
                    <p class="project-link-row">
                      <a href={project.link} target="_blank" rel="noreferrer">
                        View repository
                      </a>
                    </p>
                  )
                }
              </section>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll("[data-project-tab]"));
  const panels = Array.from(document.querySelectorAll("[data-project-panel]"));

  const activateProject = (projectId) => {
    tabs.forEach((tab) => {
      const active = tab.dataset.projectId === projectId;
      tab.classList.toggle("is-active", active);
      tab.setAttribute("aria-selected", active ? "true" : "false");
    });

    panels.forEach((panel) => {
      const active = panel.dataset.projectId === projectId;
      panel.classList.toggle("is-active", active);
      panel.hidden = !active;
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      activateProject(tab.dataset.projectId);
    });
  });

  document.querySelectorAll(".workflow-diagram-wrapper").forEach((wrapper) => {
    wrapper.addEventListener("click", () => {
      const modal = document.getElementById(`diagram-modal-${wrapper.dataset.projectId}`);
      if (modal) modal.showModal();
    });

    wrapper.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        wrapper.click();
      }
    });
  });

  document.querySelectorAll(".diagram-modal").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  });
</script>

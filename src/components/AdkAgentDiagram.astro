  <text x="665" y="108" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 8px; fill: #6f675f;">auth / limits / files</text>

  <rect x="300" y="185" width="200" height="64" rx="12" fill="#faf7f1" stroke="#34302c" stroke-width="2" filter="url(#adk-shadow)"/>

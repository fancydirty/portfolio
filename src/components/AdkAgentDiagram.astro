  <text x="400" y="228" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 8px; fill: #6f675f;">representative reasoning layer</text>

  <rect x="60" y="300" width="150" height="48" rx="8" fill="#f1ece4" stroke="#34302c" stroke-width="1.25"/>

---
// adk-agent system diagram for the WorkDossier section.
---

<svg
  viewBox="0 0 800 520"
  width="100%"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-labelledby="adk-title adk-desc"
  xmlns="http://www.w3.org/2000/svg"
  style="display: block; max-width: 100%;"
>
  <title id="adk-title">adk-agent system</title>
  <desc id="adk-desc">Architecture diagram showing recruiter chat flowing through a Next frontend, FastAPI gateway, ADK runner, tools, storage, and resumable stream replay.</desc>

  <defs>
    <filter id="adk-shadow" x="-2%" y="-2%" width="104%" height="104%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#34302c" flood-opacity="0.08"/>
    </filter>
  </defs>

  <rect x="0" y="0" width="800" height="520" fill="#faf7f1" rx="4"/>

  <text
    x="400"
    y="28"
    text-anchor="middle"
    style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; fill: #9f4b16; letter-spacing: 0.05em;"
  >
    adk-agent system
  </text>

  <rect x="55" y="70" width="160" height="54" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#adk-shadow)"/>
  <text x="135" y="92" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; fill: #34302c;">Recruiter Browser</text>
  <text x="135" y="108" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 8px; fill: #6f675f;">chat / upload / resume</text>

  <rect x="300" y="70" width="170" height="54" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#adk-shadow)"/>
  <text x="385" y="92" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; fill: #34302c;">Next.js Frontend</text>
  <text x="385" y="108" text-anchor="middle" style="font-family: 'JetBrains Mono', monospace; font-size: 8px; fill: #6f675f;">assistant-ui surface</text>

  <rect x="585" y="70" width="160" height="54" rx="8" fill="#f5efe6" stroke="#9f4b16" stroke-width="1.5" filter="url(#adk-shadow)"/>
